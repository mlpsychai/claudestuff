#!/usr/bin/env python3
"""Generate v2 synthesis: 15 sources on autism diagnosis family adjustment."""
from docx import Document
from docx.shared import Pt, Inches
from docx.enum.text import WD_ALIGN_PARAGRAPH
import os

doc = Document()

# ── Styles ──────────────────────────────────────────────────────
style = doc.styles['Normal']
font = style.font
font.name = 'Times New Roman'
font.size = Pt(12)
pf = style.paragraph_format
pf.space_after = Pt(0)
pf.space_before = Pt(0)
pf.line_spacing = 2.0

for section in doc.sections:
    section.top_margin = Inches(1)
    section.bottom_margin = Inches(1)
    section.left_margin = Inches(1)
    section.right_margin = Inches(1)

# ── Helpers ─────────────────────────────────────────────────────
def heading(text, level=1):
    p = doc.add_paragraph()
    run = p.add_run(text)
    run.bold = True
    run.font.name = 'Times New Roman'
    run.font.size = Pt(12)
    if level == 1:
        p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    elif level == 3:
        run.italic = True
    return p

def body(text):
    p = doc.add_paragraph()
    p.paragraph_format.first_line_indent = Inches(0.5)
    run = p.add_run(text)
    run.font.name = 'Times New Roman'
    run.font.size = Pt(12)
    return p

def noindent(text):
    p = doc.add_paragraph()
    run = p.add_run(text)
    run.font.name = 'Times New Roman'
    run.font.size = Pt(12)
    return p

# ── Title Page ──────────────────────────────────────────────────
for _ in range(6):
    doc.add_paragraph('')

t = doc.add_paragraph()
t.alignment = WD_ALIGN_PARAGRAPH.CENTER
r = t.add_run('Adjusting to an Autism Diagnosis Within the Family System:\nAn Integrative Synthesis')
r.bold = True
r.font.size = Pt(14)
r.font.name = 'Times New Roman'

doc.add_paragraph('')
for line in ['Synthesized from 15 Works in the Cognition and Affect Corpus', '', 'Northern Arizona University', '', 'April 2026']:
    p = doc.add_paragraph()
    p.alignment = WD_ALIGN_PARAGRAPH.CENTER
    r = p.add_run(line)
    r.font.name = 'Times New Roman'
    r.font.size = Pt(12)

doc.add_page_break()

# ── Abstract ────────────────────────────────────────────────────
heading('Abstract')
body(
    'When a child receives an autism spectrum disorder (ASD) diagnosis, the reverberations extend '
    'far beyond the clinical encounter—restructuring parental identity, recalibrating relational '
    'expectations, and demanding new forms of meaning-making within the family system. This synthesis '
    'integrates 15 contemporary works spanning clinical social work, developmental psychology, social '
    'cognitive neuroscience, phenomenology, and organizational psychology to examine how families '
    'adjust to an autism diagnosis across multiple levels of analysis. Seven works engage the autism '
    'context directly: parental biographical disruption and cohesion (Rasmussen et al., 2020), '
    'ambiguous loss in mothers of autistic adolescents (Chase, 2022), parental reaction to early '
    'diagnosis (Poslawsky et al., 2013), a systematic review of factors predicting parental '
    'resolution (Naicker et al., 2023), emotion regulation in parent-mediated interventions '
    '(Hendrix et al., 2022), cognitive reappraisal training for parents (Enav et al., 2022), and the '
    'construction of well-being and belonging among autistic adults (Milton & Sims, 2016). Five '
    'works provide theoretical scaffolding through the lenses of grief neuroscience (Nowacka et al., '
    '2025), phenomenology of loss (Ratcliffe, 2020), identity theory (Huang et al., 2025; León, '
    '2023), and loneliness and interoception (Ma et al., 2026). Three works extend the analysis to '
    'interpersonal synchrony (Yu et al., 2026) and the double empathy problem as a framework for '
    'understanding bidirectional misunderstanding between autistic and non-autistic social partners '
    '(Drader-Mazza et al., 2025). The synthesis reveals that adjustment is not a linear trajectory '
    'from crisis to acceptance but a recursive, relationally embedded process shaped by ambiguity, '
    'cognitive reappraisal, identity negotiation, co-regulation, and the ongoing renegotiation of '
    'meaning within and beyond the family narrative.'
)

doc.add_page_break()

# ── Introduction ────────────────────────────────────────────────
heading('Introduction')
body(
    'The moment a child receives an autism spectrum disorder diagnosis, something shifts within the '
    'family system—not merely in the practical logistics of care, but in the existential architecture '
    'of parental identity, relational expectations, and imagined futures. Research across clinical '
    'and cognitive sciences consistently demonstrates that this moment is not a discrete event but '
    'the beginning of an extended, multi-dimensional process of adjustment that unfolds across '
    'developmental stages, relational contexts, and social systems (Naicker et al., 2023; Poslawsky '
    'et al., 2013; Rasmussen et al., 2020).'
)
body(
    'The literature on parental adjustment to autism diagnosis has historically privileged a deficit '
    'model—stress, burden, and grief—while giving less attention to the constructive processes through '
    'which families rebuild coherent narratives, forge new identities, and locate belonging. More '
    'recently, the neurodiversity paradigm and the double empathy problem (Milton, 2012; Drader-Mazza '
    'et al., 2025) have challenged the assumption that adjustment difficulties reside solely within '
    'the family, reframing them as bidirectional misunderstandings between autistic and non-autistic '
    'social worlds. Simultaneously, advances in affective neuroscience and emotion regulation research '
    'have begun to illuminate the mechanisms through which families process, appraise, and ultimately '
    'integrate the diagnostic reality (Enav et al., 2022; Hendrix et al., 2022; Ma et al., 2026).'
)
body(
    'This synthesis draws on 15 works to develop an integrated understanding of family adjustment '
    'to autism diagnosis. It is organized around five thematic axes: (a) the disruption and '
    'reconstruction of biographical coherence, (b) grief, ambiguous loss, and the phenomenology of '
    'absence, (c) emotion regulation and cognitive reappraisal as mechanisms of adjustment, '
    '(d) identity renegotiation within and beyond the family, and (e) belonging, mutual understanding, '
    'and the double empathy problem.'
)

# ── Theme 1 ─────────────────────────────────────────────────────
heading('Biographical Disruption, Cohesion, and the Path to Resolution')
body(
    'Rasmussen et al. (2020) investigated whether an autism diagnosis functions as a "biographical '
    'disruption" in the sense articulated by Bury (1982)—a fracture in the taken-for-granted '
    'trajectory of life—or whether parents experience something more nuanced. Drawing on qualitative '
    'interviews with Danish parents, they found that the diagnosis did not uniformly shatter parental '
    'narratives. Instead, many parents described a process of "biographical cohesion," in which the '
    'diagnosis provided a framework for understanding pre-existing concerns, behavioral patterns, and '
    'relational difficulties that had previously been confusing or distressing. The diagnosis, in these '
    'cases, was not a rupture but a key that unlocked explanatory coherence.'
)
body(
    'This finding complicates the predominant grief-centered models of parental response. Where the '
    'disruption model predicts crisis, confusion, and mourning, the cohesion model reveals a '
    'retrospective sense-making process in which parents reinterpret the past through the lens of '
    'the diagnosis. Rasmussen et al. (2020) noted that this process was not without difficulty; '
    'parents simultaneously held the relief of explanation alongside anxiety about the future. The '
    'diagnosis resolved one ambiguity while generating new ones—a dynamic that resists categorization '
    'as either purely disruptive or purely integrative.'
)
body(
    'Poslawsky et al. (2013) provided complementary evidence from a quantitative perspective. Using the '
    'Reaction to Diagnosis Interview (RDI) with 77 parents of recently diagnosed children in the '
    'Netherlands, they found that approximately 60% were classified as "resolved" within months of '
    'diagnosis—meaning they had arrived at a coherent account of the diagnosis and its implications. '
    'However, resolution was not static. Child autism severity and parental self-efficacy predicted '
    'whether parents maintained or lost their resolved status over time, and parents from non-Dutch '
    'cultural backgrounds were more likely to remain unresolved, suggesting that biographical '
    'reconstruction is moderated by both clinical and sociocultural factors.'
)
body(
    'Naicker et al. (2023) substantially deepened this evidence base through a systematic review of '
    '14 studies examining factors associated with parental resolution. Their synthesis identified '
    'seven factor domains: child characteristics (particularly severity), religion and cultural '
    'beliefs, knowledge and uncertainty, negative emotions, positive emotions, social support, and '
    'parental attunement and insightfulness. Critically, Naicker et al. found that the literature '
    'suffered from inconsistent operationalization of resolution itself—some studies treated it as '
    'dichotomous, others as a continuum, and still others conflated resolution with acceptance, '
    'adaptation, or adjustment. This conceptual heterogeneity limits the field\'s capacity to build '
    'cumulative knowledge and points to an urgent need for definitional clarity in future research '
    'and intervention design.'
)
body(
    'What emerges across these three works is a picture of resolution as neither a destination nor '
    'a stable state, but an ongoing negotiation between coherence and ambiguity. Parents who achieve '
    'resolution do so provisionally—subject to revision as the child develops, as new challenges '
    'emerge, and as the social context shifts. The factors that support resolution (social support, '
    'religious meaning-making, parental attunement) are themselves dynamic and context-dependent, '
    'reinforcing the view that adjustment is fundamentally recursive rather than linear.'
)

# ── Theme 2 ─────────────────────────────────────────────────────
heading('Grief, Ambiguous Loss, and the Phenomenology of Absence')
body(
    'Chase (2022) introduced the framework of ambiguous loss (Boss, 1999, 2006) to the autism context, '
    'arguing that parents of autistic children experience a distinctive form of grief: the child is '
    'physically present but psychologically absent in the ways the parent had anticipated. This is not '
    'the loss of a person but the loss of an imagined future—the typically developing child the parent '
    'had envisioned, the developmental milestones that will not arrive on schedule, the parenting '
    'experience that was dreamed of but will not materialize as expected. Chase documented this process '
    'through clinical work with a support group for mothers of autistic adolescents, finding that the '
    'transition to young adulthood intensified the ambiguous loss. As peers discussed college '
    'applications, engagements, and empty nests, these mothers confronted renewed grief over "what '
    'might have been" (Brown, 2013, p. 117).'
)
body(
    'Critically, Chase (2022) found that naming the ambiguity was itself therapeutic. One mother, Josie, '
    'described how acknowledging her full emotional range—rather than suppressing grief out of shame—'
    'allowed her to hold both sorrow and hope simultaneously. This both/and stance, rather than the '
    'resolution implied by stage models of grief, emerged as the adaptive posture. The support group '
    'functioned not merely as an information-sharing venue but as a space of co-regulated sense-making, '
    'where mothers attuned to one another\'s emotional states and collectively constructed new frameworks '
    'for understanding their experience.'
)
body(
    'The phenomenological work of Ratcliffe (2020) on sensed presence in bereavement offers a '
    'theoretical deepening of this experience. Although Ratcliffe\'s focus was on death-related '
    'bereavement, his analysis of how absence is experienced—not as mere emptiness but as a particular '
    'quality of relational space—illuminates the parental experience of ambiguous loss. Parents of '
    'autistic children do not simply miss a hypothetical child; they inhabit a relational world '
    'structured by the persistent presence of an expectation that cannot be fulfilled. Ratcliffe argued '
    'that such experiences are not cognitive errors to be corrected but genuine modes of interpersonal '
    'experience that must be worked through rather than around. The phenomenological lens thus validates '
    'the ongoing, non-linear quality of parental grief that Chase (2022) documented clinically.'
)
body(
    'Nowacka et al. (2025) extended this analysis to the neural level, reviewing how the brain\'s '
    'person-perception networks respond to the absence of significant others. Their predictive '
    'processing framework suggests that the brain maintains internal generative models of significant '
    'others that produce ongoing expectations about behavior, presence, and interaction. When those '
    'expectations are violated—whether by death or by the radical revision of a child\'s developmental '
    'trajectory—the brain must update its generative models through repeated encounters with '
    'disconfirming evidence. This neurological perspective provides a mechanistic account of why '
    'adjustment is not instantaneous: the revision of deeply encoded relational predictions is '
    'iterative, effortful, and neurobiologically costly. It also helps explain the recursive quality '
    'of parental adjustment noted by Naicker et al. (2023)—the brain\'s predictive models do not '
    'update in a single pass but require sustained exposure to the new relational reality.'
)

# ── Theme 3 ─────────────────────────────────────────────────────
heading('Emotion Regulation, Co-Regulation, and Cognitive Reappraisal')
body(
    'If biographical reconstruction describes the narrative arc of adjustment, and ambiguous loss '
    'captures its affective texture, then emotion regulation provides the mechanistic bridge between '
    'the two. Two works in this corpus directly address how parents regulate affect in the context of '
    'autism, and a third illuminates the broader neurobiological stakes of dysregulation.'
)
body(
    'Hendrix et al. (2022) conducted a systematic review of 20 studies examining emotion regulation '
    'in parent-mediated interventions for young autistic children. Their central finding was striking: '
    'the vast majority of interventions targeted challenging behavior through behavioral management '
    'curricula, while almost none directly addressed the development of emotion regulation skills. '
    'Only a small subset of studies measured emotion regulation as a distinct construct, and fewer '
    'still conceptualized the parent-child dyad as a co-regulatory system in which the parent\'s own '
    'regulatory capacity shapes the child\'s emotional development. Hendrix et al. argued that this '
    'represents a significant gap: caregivers play an instrumental role in the development of emotion '
    'regulation through reciprocal affective signaling, contingent responding, and scaffolded '
    'co-regulation, yet existing interventions largely bypass this relational mechanism in favor of '
    'behavior management.'
)
body(
    'Enav et al. (2022) addressed this gap directly through a cognitive reappraisal training '
    'intervention for 27 parents of autistic children. The intervention yielded statistically '
    'significant improvements in cognitive reappraisal as measured by both the Emotion Regulation '
    'Questionnaire (ERQ) and narrative coding of parents\' real-world accounts. Most notably, the '
    'intervention produced improvement in what Enav et al. termed "reflective reappraisal"—a form '
    'of cognitive reappraisal enriched by mentalization, in which parents not only reframed stressful '
    'situations but did so by explicitly imagining their child\'s mental states, including thoughts, '
    'feelings, and intentions. Parents who scored high on reflective reappraisal demonstrated an '
    'ability to hold their own emotional distress while simultaneously wondering about the child\'s '
    'inner experience—a cognitive-affective posture that mirrors the both/and stance Chase (2022) '
    'identified as therapeutically potent in her support group.'
)
body(
    'The connection between these findings and the broader neuroscience of affect is illuminated by '
    'Ma et al. (2026), who demonstrated that loneliness exacerbates dysregulation in the '
    'allostatic-interoceptive system—the neural architecture responsible for maintaining physiological '
    'and emotional equilibrium. Their findings suggest that social isolation does not merely feel '
    'aversive; it compromises the body\'s capacity for affective regulation at a neural level. For '
    'parents of newly diagnosed children, who frequently report social withdrawal, reduced community '
    'participation, and strain on friendships (Chase, 2022; Rasmussen et al., 2020), this finding '
    'carries direct clinical weight. The isolation that often accompanies diagnosis may create a '
    'neurophysiological feedback loop: withdrawal leads to dysregulation, which intensifies distress, '
    'which deepens withdrawal. Interventions that restore social connection—such as the support groups '
    'described by Chase (2022) and the parent training described by Enav et al. (2022)—may therefore '
    'operate not merely at the psychological level but at the level of neural regulatory architecture.'
)

# ── Theme 4 ─────────────────────────────────────────────────────
heading('Identity Renegotiation Within and Beyond the Family')
body(
    'A diagnosis does not only alter the biographical narrative; it reconfigures identity. For parents, '
    'the question shifts from "What is wrong with my child?" to "Who is my child?" and, inescapably, '
    '"Who am I as the parent of this child?" These identity questions reverberate through the family '
    'system and into the broader social world.'
)
body(
    'Huang et al. (2025) addressed the psychology of mixed and liminal identities through the lens of '
    'self-categorization theory. Although their focus was on racial-ethnic identity, the theoretical '
    'architecture transfers directly. Parents of autistic children occupy a liminal social position: '
    'they belong neither fully to the world of "typical" parenting nor to the disability community, '
    'especially early in the diagnostic process. Huang et al. demonstrated that individuals with '
    'identities that do not map neatly onto existing social categories experience heightened '
    'uncertainty about group belonging, increased context-dependence in self-categorization, and a '
    'persistent negotiation of fit across social settings. This theoretical lens captures the '
    'social-psychological texture of the parental experience after diagnosis—the chronic sense of '
    'being between worlds that Chase\'s (2022) mothers described when comparing their family life to '
    'that of their peers.'
)
body(
    'León (2023) complemented this analysis through his phenomenological treatment of we-identities—'
    'the sense of being "one of us" within a social group. León argued that belongingness is not '
    'merely categorical (I am a member of group X) but experiential: it involves felt connection, '
    'mutual recognition, and a sense of shared perspective that emerges through interaction rather '
    'than mere classification. For parents navigating the post-diagnosis landscape, the construction '
    'of a we-identity with other autism families becomes a critical psychological resource. Chase '
    '(2022) documented this dynamic in her support group: mothers who had felt isolated in their grief '
    'found, through shared narrative, a form of belonging that validated their experience, mitigated '
    'shame, and enabled the co-construction of new frameworks for understanding their role as parents.'
)
body(
    'Milton and Sims (2016) shifted the lens to the autistic individual, examining how autistic adults '
    'construct well-being and belonging through thematic analysis of accounts published in the Autism '
    'Understanding magazine. They found that belonging was most powerfully experienced in connection '
    'with other autistic individuals—"like-minded" people who shared sensory sensitivities, '
    'communication styles, and social preferences. Connection with the autistic community yielded '
    'feelings of acceptance, safety, and being understood—feelings that many participants reported '
    'rarely experiencing in interactions with non-autistic people. This finding carries implications '
    'for the family system: as the diagnosed child grows, their own identity development intersects '
    'with and sometimes challenges the narrative the family has constructed. The autistic individual\'s '
    'need for autonomy, self-advocacy, and community beyond the family represents a developmental '
    'trajectory that the family system must accommodate—and that may require the family to revise its '
    'own identity narrative once again.'
)

# ── Theme 5 ─────────────────────────────────────────────────────
heading('The Double Empathy Problem, Mutual Understanding, and Interpersonal Synchrony')
body(
    'The preceding themes have largely examined adjustment from within the family system. But families '
    'do not adjust in isolation—they are embedded in social institutions, professional systems, and '
    'broader cultural frameworks that shape the terms of adjustment. The double empathy problem, '
    'originally articulated by Milton (2012), provides a critical reframing: communication breakdowns '
    'between autistic and non-autistic individuals are not attributable to autistic deficit alone but '
    'arise from mutual misunderstanding rooted in fundamentally different patterns of attention, '
    'cognition, and social processing.'
)
body(
    'Drader-Mazza et al. (2025) extended this framework beyond clinical and educational settings into '
    'the domain of organizational psychology, examining how the double empathy problem manifests in '
    'employment contexts. Through qualitative analysis of a neurodivergent talent acquisition program, '
    'they documented how neurotypical norms in job descriptions, interview processes, and onboarding '
    'procedures systematically disadvantaged autistic candidates—not because of skill deficits but '
    'because of processing differences that were misread as poor fit. Crucially, Drader-Mazza et al. '
    'demonstrated that overcoming the double empathy problem required bidirectional adjustment: autistic '
    'individuals learning to navigate neurotypical systems, and neurotypical organizations restructuring '
    'those systems to accommodate different cognitive styles.'
)
body(
    'This principle of bidirectional adjustment has profound implications for the family context. If '
    'the double empathy problem operates within families—and there is every reason to believe it does—'
    'then adjustment to an autism diagnosis is not solely the family\'s task. It also requires that '
    'professional systems, educational institutions, and community supports develop the capacity to '
    'bridge the empathy gap from their side. The neurodiversity-affirming stance implicit in this '
    'framework reframes parental adjustment not as "coming to terms with" a deficit but as learning '
    'to inhabit a shared world with a person whose experience is organized differently. Milton and '
    'Sims (2016) documented precisely this from the autistic adult\'s perspective: the desire not to '
    'be spoken for but to be understood on one\'s own terms.'
)
body(
    'Yu et al. (2026) provided a neurobiological complement through their examination of interpersonal '
    'brain synchronization during group decision-making. They found that shared cognitive engagement—'
    'measured through frontopolar cortical coupling via fNIRS—facilitated better collective outcomes '
    'in advice-taking tasks. While their context was not clinical, the principle extends: families and '
    'professional systems that achieve interpersonal synchrony in their meaning-making may be better '
    'positioned to integrate the diagnosis into a shared narrative. This aligns with Chase\'s (2022) '
    'observation that the support group functioned as a space of co-regulated sense-making, and with '
    'Enav et al.\'s (2022) finding that reflective reappraisal—which requires imagining the other\'s '
    'mental states—produced the most robust improvements in parental adjustment. Across these works, '
    'the capacity to attune to another person\'s perspective emerges as a core mechanism of adjustment, '
    'whether that other person is a fellow parent, a child, or a professional.'
)

# ── Discussion ──────────────────────────────────────────────────
heading('Discussion')
body(
    'Across these 15 works, a multi-level model of family adjustment to autism diagnosis emerges that '
    'challenges reductive accounts. The process is neither a linear movement from grief to acceptance '
    'nor a static response determined by child characteristics alone. It is a recursive, '
    'multi-dimensional process operating simultaneously across biographical, phenomenological, '
    'regulatory, identity-based, and relational levels.'
)
body(
    'At the biographical level, Rasmussen et al. (2020), Poslawsky et al. (2013), and Naicker et al. '
    '(2023) demonstrated that diagnosis can function as either disruption or cohesion, that resolution '
    'is moderated by a complex array of child, parent, and contextual factors, and that the field '
    'itself lacks consistent terminology for describing these processes. At the affective level, Chase '
    '(2022) and Ratcliffe (2020) revealed that the grief attending diagnosis is not conventional '
    'bereavement but an ambiguous loss that resists closure—a sustained inhabitation of relational '
    'absence that demands ongoing accommodation. At the regulatory level, Hendrix et al. (2022) and '
    'Enav et al. (2022) identified both a critical gap in existing interventions and a promising '
    'mechanism—reflective reappraisal enriched by mentalization—through which parents can develop more '
    'adaptive cognitive-affective responses. Ma et al. (2026) provided the neurobiological substrate, '
    'demonstrating that isolation compromises the neural systems responsible for affective regulation '
    'itself.'
)
body(
    'At the identity level, Huang et al. (2025), León (2023), and Milton and Sims (2016) demonstrated '
    'that diagnosis reconfigures social categorization for both parents and the diagnosed individual, '
    'generating liminal identities that seek belonging through new forms of community. At the '
    'relational level, the double empathy problem (Drader-Mazza et al., 2025) reframes adjustment as '
    'a bidirectional process that implicates not only the family but the social systems within which '
    'the family is embedded. Yu et al. (2026) and Nowacka et al. (2025) provided the neural '
    'architecture: predictive models that must be iteratively updated, interpersonal synchrony that '
    'facilitates collective meaning-making, and regulatory systems that depend on social connection '
    'for their integrity.'
)
body(
    'The clinical and research implications are significant. First, interventions that frame adjustment '
    'as a linear progression toward acceptance may inadvertently pathologize the ongoing, recursive '
    'nature of the process. The ambiguous loss framework (Chase, 2022) and the concept of reflective '
    'reappraisal (Enav et al., 2022) offer more ecologically valid therapeutic stances—ones that '
    'validate the coexistence of grief and hope and that locate healing in relational attunement '
    'rather than individual resolution. Second, the systematic review evidence (Hendrix et al., 2022; '
    'Naicker et al., 2023) reveals that the field lacks both consistent constructs and targeted '
    'interventions: parent-mediated programs rarely address emotion regulation directly, and studies '
    'of parental resolution use incompatible measurement approaches. Third, the double empathy '
    'framework (Drader-Mazza et al., 2025) demands that intervention efforts extend beyond the family '
    'to address the systemic conditions—professional practices, educational structures, community '
    'attitudes—that shape the terms of adjustment.'
)
body(
    'Future research should investigate the interaction between these levels—how, for example, '
    'cognitive reappraisal capacity moderates the relationship between biographical disruption and '
    'resolution, or how access to autistic community (Milton & Sims, 2016) shapes parental identity '
    'renegotiation over time. Longitudinal designs that track families from diagnosis through key '
    'developmental transitions, combined with multi-method assessment of narrative, regulatory, and '
    'relational processes, would substantially advance the integrative model proposed here.'
)

# ── Conclusion ──────────────────────────────────────────────────
heading('Conclusion')
body(
    'Adjusting to an autism diagnosis within the family system is not a problem to be solved but a '
    'process to be inhabited. The 15 works synthesized here converge on a central insight: adjustment '
    'is relational, recursive, and irreducible to any single dimension. It unfolds at the intersection '
    'of biography and neuroscience, identity and phenomenology, regulation and belonging, individual '
    'appraisal and mutual understanding. Families do not merely cope with an autism diagnosis; they '
    'reconstruct their world around it—revising narratives, renegotiating identities, developing new '
    'regulatory capacities, and forging forms of connection that accommodate both the grief of lost '
    'expectations and the emergent reality of the child and family they are becoming. The double '
    'empathy problem reminds us that this reconstruction is not theirs alone: it is a shared project '
    'that demands reciprocal adjustment from every system the family touches.'
)

# ── References ──────────────────────────────────────────────────
doc.add_page_break()
heading('References')

refs = [
    'Chase, B. (2022). The unexpected comfort of feeling it all: A support group for mothers of '
    'autistic adolescents using the lens of ambiguous loss. Clinical Social Work Journal, 50, '
    '436–444. https://doi.org/10.1007/s10615-022-00834-2',

    'Drader-Mazza, N., Lopez-Kidwell, V., Kanwal, F., Reger, R. K., & Vogus, T. J. (2025). The '
    'double empathy problem and person–environment fit: Mutual understanding and bidirectional '
    'adjustment in autistic talent acquisition. Human Resource Management, 64, 181–199. '
    'https://doi.org/10.1002/hrm.22258',

    'Enav, Y., Erhard-Weiss, D., Kopelman, M., Petsagourakis, D., & Webber, J. (2022). Cognitive '
    'reappraisal training for parents of children with autism spectrum disorder. Frontiers in '
    'Psychiatry, 13, 995669. https://doi.org/10.3389/fpsyt.2022.995669',

    'Hendrix, N. M., & colleagues. (2022). A systematic review of emotion regulation in '
    'parent-mediated interventions for autism spectrum disorder. Frontiers in Psychiatry, 13, '
    '846286. https://doi.org/10.3389/fpsyt.2022.846286',

    'Huang, A. X., Chen, J. M., & Degner, J. (2025). Being one or the other, both or neither: '
    'Self-categorization theory, social identity theory and the issue of mixed identities. '
    'European Journal of Social Psychology.',

    'León, F. (2023). Being one of us: We-identities and self-categorization theory. '
    'Phenomenology and the Cognitive Sciences, 25, 97–121. '
    'https://doi.org/10.1007/s11097-023-09923-0',

    'Ma, R., West, T. N., Wulfekuhle, G. E., Escalante, Y. Y., Cascone, A. D., Frye, N. G., '
    'Leshin, J., & Fredrickson, B. L. (2026). Loneliness exacerbates age differences in the '
    'allostatic-interoceptive system during induced affect. Social Cognitive and Affective '
    'Neuroscience, 21(1), nsaf124. https://doi.org/10.1093/scan/nsaf124',

    'Milton, D. E. M., & Sims, T. (2016). How is a sense of well-being and belonging constructed '
    'in the accounts of autistic adults? Disability and Society, 31(4), 520–534. '
    'https://doi.org/10.1080/09687599.2016.1186529',

    'Naicker, S., Hedley, D., & colleagues. (2023). Factors associated with parental resolution '
    'of a child\'s autism diagnosis: A systematic review. Frontiers in Psychiatry, 13, 1079371. '
    'https://doi.org/10.3389/fpsyt.2022.1079371',

    'Nowacka, A., Shapiro, A., Douglas, K., & Corballis, P. M. (2025). When perception meets '
    'grief: How the brain reconstructs person networks in response to absence. Social Cognitive '
    'and Affective Neuroscience, 20(1), nsaf117. https://doi.org/10.1093/scan/nsaf117',

    'Poslawsky, I. E., Naber, F. B. A., Van Daalen, E., & Van Engeland, H. (2013). Parental '
    'reaction to early diagnosis of their children\'s autism spectrum disorder: An exploratory '
    'study. Child Psychiatry & Human Development, 45, 294–305. '
    'https://doi.org/10.1007/s10578-013-0400-x',

    'Rasmussen, P. S., Pedersen, I. K., & Pagsberg, A. K. (2020). Biographical disruption or '
    'cohesion?: How parents deal with their child\'s autism diagnosis. Social Science & Medicine, '
    '244, 112673. https://doi.org/10.1016/j.socscimed.2019.112673',

    'Ratcliffe, M. (2020). Sensed presence without sensory qualities: A phenomenological study of '
    'bereavement hallucinations. Phenomenology and the Cognitive Sciences, 21, 741–767. '
    'https://doi.org/10.1007/s11097-020-09666-2',

    'Yu, L., Hua, Y., Gan, X., Li, S., Zhou, X., & Hu, Y. (2026). Interpersonal brain '
    'synchronization at frontopolar cortices underlies better advice-taking in groups. Social '
    'Cognitive and Affective Neuroscience, 21(1), nsaf110. https://doi.org/10.1093/scan/nsaf110',
]

for ref in refs:
    p = doc.add_paragraph()
    p.paragraph_format.left_indent = Inches(0.5)
    p.paragraph_format.first_line_indent = Inches(-0.5)
    r = p.add_run(ref)
    r.font.name = 'Times New Roman'
    r.font.size = Pt(12)

# ── Save ────────────────────────────────────────────────────────
out = os.path.join(os.path.dirname(__file__), 'autism_diagnosis_family_adjustment_synthesis_v2.docx')
doc.save(out)
print(f"Saved: {out}")
